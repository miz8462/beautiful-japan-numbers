[Unit]
Description=Watch Downloads and sync Excel files to Google Drive
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/mizki/projects/beautiful-japan-numbers
ExecStart=/home/mizki/projects/beautiful-japan-numbers/.venv/bin/python /home/mizki/projects/beautiful-japan-numbers/scripts/ingest/gdrive_watcher.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target