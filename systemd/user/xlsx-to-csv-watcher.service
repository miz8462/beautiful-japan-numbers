[Unit]
Description=Watch data/raw and convert xlsx sheets to data/csv
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/mizki/projects/beautiful-japan-numbers
ExecStart=/home/mizki/projects/beautiful-japan-numbers/venv/bin/python /home/mizki/projects/beautiful-japan-numbers/scripts/ingest/xlsx_to_csv_watcher.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
